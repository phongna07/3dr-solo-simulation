# Copy to .env; scripts/dev supplies your UID/GID automatically.
COMPOSE_PROJECT_NAME=solo
SIM_IMAGE=solo-simulation:gd0
COMPANION_IMAGE=solo-companion:gd0
ROS_DOMAIN_ID=42
# reference: original Iris + gimbal/camera; control: remove gimbal/camera.
SIM_PROFILE=control
FLEET_CONFIG=/workspace/config/fleet.yaml
READINESS_TIMEOUT=600
# Empty for hardware acceleration; set to 1 for software rendering fallback.
LIBGL_ALWAYS_SOFTWARE=
# MPC experiment inputs (used by ./scripts/dev mpc). Camera target mode is default.
MPC_SCENARIO=/workspace/ros_ws/src/solo_mpc/scenarios/small50_3uav.yaml
MPC_SETTINGS=/workspace/ros_ws/src/solo_mpc/config/controller.yaml
MPC_TARGET_MODE=
