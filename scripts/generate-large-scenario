#!/usr/bin/env python3
"""Write a reproducible random 200 m, five-UAV scenario (standard library only)."""

import argparse
import json
import math
from pathlib import Path
import random


def segment_distance(point, a, b):
    dx, dy = b[0] - a[0], b[1] - a[1]
    t = max(0.0, min(1.0, ((point[0] - a[0]) * dx + (point[1] - a[1]) * dy)
                    / (dx * dx + dy * dy)))
    return math.hypot(point[0] - a[0] - t * dx, point[1] - a[1] - t * dy)


def generate(seed):
    rng = random.Random(seed)
    # The first target point is exactly under uav1's downward optical axis.
    starts = [[16, 16, 3], [13.375, 16, 3], [18.625, 16, 3],
              [16, 13.375, 3], [16, 18.625, 3]]
    anchors = [(30, 42), (65, 65), (100, 40), (145, 65), (175, 110),
               (135, 150), (90, 180), (45, 150), (25, 100)]
    waypoints = [[16, 16], [16, 23]] + [
        [round(x + rng.uniform(-7, 7), 3), round(y + rng.uniform(-7, 7), 3)]
        for x, y in anchors
    ]
    # Reserve an 8 m band around every route segment: room for spline bends,
    # the four formation slots and body clearance. Obstacles remain unknown
    # to the controller until LiDAR observes them.
    rects, circles, bounds = [], [], []
    for kind, count in (("rects", 80), ("circles", 80)):
        for _ in range(20000):
            if len(rects if kind == "rects" else circles) == count:
                break
            x, y = rng.uniform(4, 196), rng.uniform(4, 196)
            if kind == "rects":
                w, h = rng.uniform(1.5, 4), rng.uniform(1.5, 4)
                radius = math.hypot(w, h) / 2
                shape = [round(x - w / 2, 3), round(y - h / 2, 3),
                         round(w, 3), round(h, 3)]
            else:
                radius = rng.uniform(0.6, 1.5)
                shape = [round(x, 3), round(y, 3), round(radius, 3)]
            if min(segment_distance((x, y), a, b)
                   for a, b in zip(waypoints[:-1], waypoints[1:])) < 8 + radius:
                continue
            if any(math.hypot(x - p[0], y - p[1]) < 8 + radius for p in starts):
                continue
            if any(math.hypot(x - ox, y - oy) < radius + r + 0.8 for ox, oy, r in bounds):
                continue
            (rects if kind == "rects" else circles).append(shape)
            bounds.append((x, y, radius))
        else:
            raise RuntimeError("Unable to place requested obstacles; choose another seed")
    lines = [
        "# Generated by scripts/generate-large-scenario; change --seed to regenerate.",
        "description: 200 x 200 m seeded random obstacle field and winding target route",
        "world_name: mpc_large200", f"random_seed: {seed}",
        "xlim: [0, 200]", "ylim: [0, 200]", "viewing_radius: 1.5", "tar_max_speed: 0.6",
        "starts:", *[f"  - {json.dumps(p)}" for p in starts],
        "target:", "  waypoints:", *[f"    - {json.dumps(p)}" for p in waypoints],
        "obstacles:", "  rects:", *[f"    - {json.dumps(p)}" for p in rects],
        "  circles:", *[f"    - {json.dumps(p)}" for p in circles],
        "params:", "  GRID_RESOLUTION: 0.3", "  LOCAL_PLAN_RADIUS: 10",
        "  UNKNOWN_POLICY: optimistic", "  UNKNOWN_COST: 1.5",
        "  TARGET_REPLAN_THRESHOLD: 0.6", "  PATH_DEVIATION_THRESHOLD: 1.0",
        "  TAR_SMOOTH_ENABLE: true", "  TAR_SPLINE_DS: 0.1",
        "  GRID_CELLS: [[-1, 0], [1, 0], [0, -1], [0, 1]]", "",
    ]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--seed", type=int, default=200205)
    parser.add_argument("--output", type=Path, default=Path(
        "ros_ws/src/solo_mpc/scenarios/large200_5uav.yaml"))
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(generate(args.seed))
    print(f"Wrote {args.output} (seed {args.seed})")


if __name__ == "__main__":
    main()
