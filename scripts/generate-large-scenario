#!/usr/bin/env python3
"""Write a dense random 200 m, five-UAV scenario; requires project NumPy."""

import argparse
import json
import math
from pathlib import Path
import random
import sys

import numpy as np

# Use the same spline as the simulated target, including its sampled segments.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ros_ws/src/solo_mpc"))
from solo_mpc.core.target_motion import target_route


OBSTACLES_PER_KIND = 240
ROUTE_CLEARANCE = 2.0
TARGET_SPEED = 1.0
ROADSIDE_SPACING = 4.0


def generate(seed):
    rng = random.Random(seed)
    # The first target point is exactly under uav1's downward optical axis.
    starts = [[16, 16, 3], [13.375, 16, 3], [18.625, 16, 3],
              [16, 13.375, 3], [16, 18.625, 3]]
    # Short early bends are visible in time-limited recordings. Later bends
    # continue across the large map rather than repeating a local loop.
    near = [(25, 29), (16, 41), (31, 48), (43, 39), (55, 52)]
    anchors = [(65, 65), (100, 40), (145, 65), (175, 110),
               (135, 150), (90, 180), (45, 150), (25, 100)]
    waypoints = [[16, 16], [16, 23]] + [
        [round(x + rng.uniform(-1.5, 1.5), 3), round(y + rng.uniform(-1.5, 1.5), 3)]
        for x, y in near
    ] + [
        [round(x + rng.uniform(-7, 7), 3), round(y + rng.uniform(-7, 7), 3)]
        for x, y in anchors
    ]
    path, _ = target_route({"target": {"waypoints": waypoints}, "tar_max_speed": TARGET_SPEED},
                           {"TAR_SPLINE_DS": 0.1})
    if np.any(path < 2) or np.any(path > 198):
        raise RuntimeError("Smoothed route leaves the map; choose another seed")
    segments = np.diff(path, axis=0)
    squared_lengths = np.sum(segments * segments, axis=1)
    lengths = np.r_[0, np.cumsum(np.sqrt(squared_lengths))]

    def route_distance(point):
        along = np.clip(np.sum((point - path[:-1]) * segments, axis=1)
                        / np.maximum(squared_lengths, 1e-12), 0, 1)
        return float(np.min(np.linalg.norm(point - path[:-1] - along[:, None] * segments, axis=1)))

    def route_point(distance):
        return np.array([np.interp(distance, lengths, path[:, axis]) for axis in (0, 1)])

    # A bounded disc encloses each rounded footprint. Clearance from every
    # actual target segment protects the entire interpolated route, not just
    # its waypoints. UAVs still learn obstacles exclusively through LiDAR.
    rects, circles, bounds = [], [], []

    def dimensions(kind):
        return ([round(rng.uniform(1.5, 4), 3) for _ in range(2)] if kind == "rects"
                else [round(rng.uniform(0.6, 1.5), 3)])

    def place(kind, point, size):
        x, y = np.round(point, 3)
        radius = math.hypot(*size) / 2 if kind == "rects" else size[0]
        if not (radius + 1 < x < 199 - radius and radius + 1 < y < 199 - radius):
            return False
        # Include rounding allowance for the rectangle's lower corner.
        radius += 0.002
        if route_distance(np.array([x, y])) < ROUTE_CLEARANCE + radius:
            return False
        if any(math.hypot(x - p[0], y - p[1]) < 3 + radius for p in starts):
            return False
        if any(math.hypot(x - ox, y - oy) < radius + r + 0.5 for ox, oy, r in bounds):
            return False
        shape = ([round(x - size[0] / 2, 3), round(y - size[1] / 2, 3), *size]
                 if kind == "rects" else [float(x), float(y), *size])
        (rects if kind == "rects" else circles).append(shape)
        bounds.append((x, y, radius))
        return True

    # Place nearby scenery first so extra density reaches the recorded action.
    # Alternating clearances and mixed footprints avoid a uniform roadside wall.
    for i, distance in enumerate(np.arange(8, lengths[-1] - 3, ROADSIDE_SPACING)):
        center = route_point(distance)
        tangent = route_point(distance + 0.25) - route_point(distance - 0.25)
        normal = np.array([-tangent[1], tangent[0]]) / np.linalg.norm(tangent)
        for side in (-1, 1):
            kind = "rects" if (i + side) % 3 else "circles"
            size = dimensions(kind)
            radius = math.hypot(*size) / 2 if kind == "rects" else size[0]
            point = center + side * normal * (radius + rng.uniform(2.1, 3.0))
            place(kind, point, size)
    roadside_count = len(bounds)

    for kind, shapes in (("rects", rects), ("circles", circles)):
        for _ in range(40000):
            if len(shapes) >= OBSTACLES_PER_KIND:
                break
            place(kind, [rng.uniform(3, 197), rng.uniform(3, 197)], dimensions(kind))
        else:
            raise RuntimeError("Unable to place requested obstacles; choose another seed")
    lines = [
        "# Generated by scripts/generate-large-scenario; change --seed to regenerate.",
        "description: 200 x 200 m tight obstacle slalom with faster five-UAV tracking",
        "world_name: mpc_large200", f"random_seed: {seed}",
        f"route_clearance: {ROUTE_CLEARANCE}", f"roadside_obstacles: {roadside_count}",
        f"roadside_spacing: {ROADSIDE_SPACING}",
        "xlim: [0, 200]", "ylim: [0, 200]", "viewing_radius: 1.5", f"tar_max_speed: {TARGET_SPEED}",
        "starts:", *[f"  - {json.dumps(p)}" for p in starts],
        "target:", "  waypoints:", *[f"    - {json.dumps(p)}" for p in waypoints],
        "obstacles:", "  rects:", *[f"    - {json.dumps(p)}" for p in rects],
        "  circles:", *[f"    - {json.dumps(p)}" for p in circles],
        "params:", "  VMAX: 2.2", "  GRID_RESOLUTION: 0.3", "  LOCAL_PLAN_RADIUS: 10",
        "  UNKNOWN_POLICY: optimistic", "  UNKNOWN_COST: 1.5",
        "  TARGET_REPLAN_THRESHOLD: 0.6", "  PATH_DEVIATION_THRESHOLD: 1.0",
        "  TAR_SMOOTH_ENABLE: true", "  TAR_SPLINE_DS: 0.1",
        "  GRID_CELLS: [[-1, 0], [1, 0], [0, -1], [0, 1]]", "",
    ]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--seed", type=int, default=200205)
    parser.add_argument("--output", type=Path, default=Path(
        "ros_ws/src/solo_mpc/scenarios/large200_5uav.yaml"))
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(generate(args.seed))
    print(f"Wrote {args.output} (seed {args.seed})")


if __name__ == "__main__":
    main()
