#!/usr/bin/env bash
set -euo pipefail
TASK_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$TASK_ROOT"
LOCAL_UID="$(id -u)"
LOCAL_GID="$(id -g)"
export LOCAL_UID LOCAL_GID
dc=(docker compose)
# Let Compose parse .env (including quoting/interpolation) rather than sourcing
# it as shell code. Explicit -f options below would otherwise hide its selection.
if [[ ! -v COMPOSE_FILE && -f .env ]]; then
  TASK_COMPOSE_ENV="$(docker compose config --environment)"
  while IFS= read -r TASK_ENV_LINE; do
    case "$TASK_ENV_LINE" in
      COMPOSE_FILE=*) export COMPOSE_FILE="${TASK_ENV_LINE#COMPOSE_FILE=}" ;;
      COMPOSE_PATH_SEPARATOR=*) export COMPOSE_PATH_SEPARATOR="${TASK_ENV_LINE#COMPOSE_PATH_SEPARATOR=}" ;;
    esac
  done <<< "$TASK_COMPOSE_ENV"
  unset TASK_COMPOSE_ENV TASK_ENV_LINE
fi
TASK_COMPOSE_SEPARATOR="${COMPOSE_PATH_SEPARATOR:-:}"
if [[ -d /mnt/wslg && -d /tmp/.X11-unix ]]; then
  if [[ -n "${COMPOSE_FILE:-}" ]]; then
    [[ "$TASK_COMPOSE_SEPARATOR$COMPOSE_FILE$TASK_COMPOSE_SEPARATOR" == *"${TASK_COMPOSE_SEPARATOR}compose.wslg.yaml${TASK_COMPOSE_SEPARATOR}"* ]] || export COMPOSE_FILE="${COMPOSE_FILE}${TASK_COMPOSE_SEPARATOR}compose.wslg.yaml"
  else
    dc+=(-f compose.yaml -f compose.wslg.yaml)
  fi
elif [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
  if [[ -n "${COMPOSE_FILE:-}" ]]; then
    [[ "$TASK_COMPOSE_SEPARATOR$COMPOSE_FILE$TASK_COMPOSE_SEPARATOR" == *"${TASK_COMPOSE_SEPARATOR}compose.x11.yaml${TASK_COMPOSE_SEPARATOR}"* ]] || export COMPOSE_FILE="${COMPOSE_FILE}${TASK_COMPOSE_SEPARATOR}compose.x11.yaml"
  else
    dc+=(-f compose.yaml -f compose.x11.yaml)
  fi
elif [[ -z "${COMPOSE_FILE:-}" ]]; then
  dc+=(-f compose.yaml)
fi

usage() {
  cat <<'EOF'
Usage: ./scripts/dev COMMAND [arguments]
  doctor                         Host/Docker/config diagnostics
  build [sim]                     Build the simulation image
  run [--seconds SIM_SECONDS]     Start, await readiness, take off, track, land, evaluate,
                                  finalize any video and stop the simulation
      [--preset small50_3uav|large200_5uav|scen1]  Select matching fleet/scenario/settings
      [--fleet PATH] [--scenario PATH] [--settings PATH]  Container config paths
      [--algorithm NAME]          Override the settings algorithm (mpc|apf)
      [--record-video]            Save overhead + LiDAR map + drone states + UAV FOVs to runs/<run-id>/recorded-mission.mp4
      [--gui]                     Also open the Gazebo GUI (log: runs/<run-id>.gui.log)
  mission status|stop             Inspect or land the fleet of a running simulation
  evaluate [--run-dir DIR]       Re-evaluate a recorded run (default /workspace/runs/latest)
  status                         Show Docker state and live readiness
  logs                           Follow process logs (Ctrl+C only stops tail)
  shell                          Bash inside simulation container
  gui                            Gazebo GUI client; server keeps running on GUI exit
  stop                           LAND, await disarm, finalize video, then stop simulation
  stop --force                   Stop processes immediately, no LAND
  lock                           Export manifests and image ID to artifacts/
  pull                           Pull images specified in .env (use registry digests)
  help
EOF
}

# Cleanup steps run in their own session (see run_detached.py) when set.
shield=()

stop_simulation() {
  local run_dir="${1:-/workspace/runs/latest}" recording_status=0 shutdown_status=0
  printf 'Finalizing recording before stopping simulation.\n' >&2
  "${shield[@]}" "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint \
    python3 -m solo_mpc.core.video "$run_dir" || recording_status=$?
  # Even a failed recorder must not prevent process cleanup.
  "${shield[@]}" "${dc[@]}" stop sim || shutdown_status=$?
  if (( recording_status != 0 )); then
    printf 'Video finalization failed; retained recording inputs and logs are in %s.\n' "$run_dir" >&2
    return "$recording_status"
  fi
  return "$shutdown_status"
}

# EXIT handler of `run`, for success, failure and cancellation alike. Every step
# runs even if an earlier one fails; the first failure decides the exit status.
finish_run() {
  local status=$? landing_status=0 evaluation_status=0 recording_status=0
  set +e
  trap - EXIT
  trap '' INT TERM HUP
  shield=(python3 scripts/run_detached.py --)
  printf 'Cleaning up run %s: landing, video finalization, container stop and evaluation.\n' "$RUN_ID" >&2
  printf 'Ctrl+C is ignored; cleanup is bounded by landing watchdogs, the finalization deadline and the 150 s stop grace period. Use ./scripts/dev stop --force from another terminal only for a crashed simulation.\n' >&2
  if [[ -z "$("${dc[@]}" ps --status running -q sim)" ]]; then
    # Crashed or never started: nothing can land or finalize inside it.
    printf 'Simulation container is not running; skipping landing request and live video finalization.\n' >&2
    "${dc[@]}" stop sim > /dev/null 2>&1
    landing_status=1
  else
    if (( status != 0 && status != 130 )); then
      # Retain the failure evidence: the following stop request updates mission.json.
      "${shield[@]}" "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint python3 -c '
from pathlib import Path
import shutil, sys
status = Path(sys.argv[1]) / "status"
if (status / "mission.json").is_file():
    shutil.copyfile(status / "mission.json", status / "mission-failure.json")
' "$TASK_RUN_DIR" || printf 'Could not snapshot mission status; inspect the saved process logs.\n' >&2
    fi
    # Idempotent after a completed mission; it confirms settled ground and disarm.
    "${shield[@]}" "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint \
      ros2 run solo_mpc mission stop --run-dir "$TASK_RUN_DIR" || landing_status=$?
    (( landing_status == 0 )) || printf 'Landing cleanup failed or the supervisor is unavailable (exit %s); still finalizing video and stopping.\n' "$landing_status" >&2
    printf 'Stopping simulation; waiting for video encoding and verification.\n' >&2
    stop_simulation "$TASK_RUN_DIR" || recording_status=$?
  fi
  # A recorder that died with its container leaves compressed segments; the
  # stopped stack makes offline recovery safe.
  if [[ "$MPC_RECORD_VIDEO" == true && -d "runs/${RUN_ID}/recorded-mission.mp4.encoding" ]] &&
     ! python3 -c 'import json, sys; sys.exit(json.load(open(sys.argv[1]))["state"] not in ("finalized", "partial", "empty"))' \
       "runs/${RUN_ID}/status/recording.json" 2> /dev/null; then
    printf 'Recovering compressed video segments from the stopped recorder.\n' >&2
    recording_status=0
    "${shield[@]}" "${dc[@]}" run --rm --no-deps -T sim \
      python3 -m solo_mpc.core.video "$TASK_RUN_DIR" --recover || recording_status=$?
  fi
  if "$TASK_MISSION_STARTED"; then
    # A one-off container evaluates the complete telemetry after shutdown.
    "${shield[@]}" "${dc[@]}" run --rm --no-deps -T sim \
      ros2 run solo_mpc evaluate --run-dir "$TASK_RUN_DIR" || evaluation_status=$?
    if (( evaluation_status == 0 )); then
      printf 'Evaluation saved to runs/%s/reports/evaluation.json.\n' "$RUN_ID" >&2
    else
      printf 'Evaluation failed (exit %s).\n' "$evaluation_status" >&2
    fi
  fi
  for next in "$landing_status" "$recording_status" "$evaluation_status"; do
    (( status != 0 )) || status=$next
  done
  if (( status == 0 )); then
    printf 'Run %s complete: fleet landed and simulation stopped.\n' "$RUN_ID" >&2
  else
    printf 'Run %s finished with exit %s; inspect runs/%s.\n' "$RUN_ID" "$status" "$RUN_ID" >&2
  fi
  exit "$status"
}

command="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$command" in
  doctor)
    python3 scripts/doctor.py "$@" --compose "${dc[@]:1}"
    ;;
  build)
    [[ $# -eq 0 || ( $# -eq 1 && "$1" == sim ) ]] || { usage >&2; exit 2; }
    "${dc[@]}" build sim
    ;;
  run)
    show_gui=false
    mission_seconds=0
    export MPC_RECORD_VIDEO=false
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}"
    export RUN_ID
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --preset)
          case "${2:?preset name required}" in
            small50_3uav)
              export FLEET_CONFIG=/workspace/config/fleet.yaml
              export MPC_SCENARIO=/workspace/src/solo_mpc/scenarios/small50_3uav.yaml
              export MPC_SETTINGS=/workspace/src/solo_mpc/config/controller.yaml
              ;;
            large200_5uav)
              export FLEET_CONFIG=/workspace/config/fleet-5uav.yaml
              export MPC_SCENARIO="/workspace/src/solo_mpc/scenarios/${2}.yaml"
              export MPC_SETTINGS=/workspace/src/solo_mpc/config/controller-large200.yaml
              ;;
            scen1)
              export FLEET_CONFIG=/workspace/config/fleet-5uav.yaml
              export MPC_SCENARIO=/workspace/src/solo_mpc/scenarios/scen1.yaml
              export MPC_SETTINGS=/workspace/src/solo_mpc/config/controller-scen1.yaml
              ;;
            *) printf 'Unknown MPC preset: %s\n' "$2" >&2; exit 2 ;;
          esac
          shift 2
          ;;
        --fleet) export FLEET_CONFIG="${2:?fleet path required}"; shift 2 ;;
        --scenario) export MPC_SCENARIO="${2:?scenario path required}"; shift 2 ;;
        --settings) export MPC_SETTINGS="${2:?settings path required}"; shift 2 ;;
        --algorithm) export MPC_ALGORITHM="${2:?algorithm name required}"; shift 2 ;;
        --seconds) mission_seconds="${2:?simulation seconds required}"; shift 2 ;;
        --gui) show_gui=true; shift ;;
        --record-video) export MPC_RECORD_VIDEO=true; shift ;;
        *) printf 'Unknown run argument: %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    [[ "$mission_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
      printf -- '--seconds must be a nonnegative number of simulation seconds: %s\n' "$mission_seconds" >&2
      exit 2
    }
    if [[ -n "$("${dc[@]}" ps --status running -q sim)" ]]; then
      printf 'Simulation already running. Use status/stop before starting another.\n' >&2
      exit 1
    fi
    mkdir -p runs
    TASK_RUN_DIR="/workspace/runs/${RUN_ID}"
    TASK_MISSION_STARTED=false
    # Startup: Ctrl+C aborts into the same cleanup as any other exit.
    trap 'exit 130' INT TERM HUP
    trap finish_run EXIT
    "${dc[@]}" up -d --no-build sim
    TASK_CONTAINER="$("${dc[@]}" ps -q sim)"
    docker inspect "$TASK_CONTAINER" --format '{{json .Image}}' > "runs/${RUN_ID}.image-id.json"
    python3 scripts/wait_ready.py --run-id "$RUN_ID" --container "$TASK_CONTAINER" --all-processes
    if "$show_gui"; then
      printf 'Starting Gazebo GUI; closing it leaves the mission running.\n'
      # Its own session keeps Ctrl+C for the mission; container stop ends it.
      python3 scripts/run_detached.py -- "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint \
        python3 /workspace/scripts/gazebo_gui.py > "runs/${RUN_ID}.gui.log" 2>&1 &
    fi
    # Mission: Ctrl+C becomes a cancel file; the mission client lands, then exits.
    trap : INT TERM HUP
    TASK_MISSION_STARTED=true
    python3 scripts/run_detached.py --cancel-file "runs/${RUN_ID}.mission.cancel" -- \
      "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint ros2 run solo_mpc mission run \
      --run-dir "$TASK_RUN_DIR" --seconds "$mission_seconds" \
      --cancel-file "${TASK_RUN_DIR}.mission.cancel"
    ;;
  mpc|wait)
    printf '%s was replaced by ./scripts/dev run, which starts, flies, lands and stops in one command.\n' "$command" >&2
    exit 2
    ;;
  status)
    "${dc[@]}" ps
    "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint python3 -c 'import json; from pathlib import Path; print(json.dumps(json.loads(Path("/workspace/runs/latest/status/health.json").read_text()), indent=2))'
    ;;
  logs) "${dc[@]}" logs -f --tail 100 sim ;;
  shell) "${dc[@]}" exec sim /usr/local/bin/solo-entrypoint bash ;;
  gui) "${dc[@]}" exec sim /usr/local/bin/solo-entrypoint python3 /workspace/scripts/gazebo_gui.py ;;
  mission)
    case "${1:-}" in
      status|stop) ;;
      run|start|reset)
        printf 'mission %s is part of ./scripts/dev run; only mission status|stop remain.\n' "$1" >&2
        exit 2
        ;;
      *) usage >&2; exit 2 ;;
    esac
    "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint ros2 run solo_mpc mission "$@"
    ;;
  # A separate container also works after run has stopped the simulation.
  evaluate) "${dc[@]}" run --rm --no-deps -T sim ros2 run solo_mpc evaluate "$@" ;;
  stop)
    [[ -n "$("${dc[@]}" ps --status running -q sim)" ]] || exit 0
    TASK_LANDING_STATUS=0
    if [[ "${1:-}" != --force ]]; then
      "${dc[@]}" exec -T sim /usr/local/bin/solo-entrypoint ros2 run solo_mpc mission stop || TASK_LANDING_STATUS=$?
      stop_simulation
    else
      "${dc[@]}" stop sim
    fi
    exit "$TASK_LANDING_STATUS"
    ;;
  lock)
    mkdir -p artifacts
    "${dc[@]}" run --rm --no-deps sim bash -c \
      'cp /opt/solo/*.lock /opt/solo/versions.json /opt/solo/application.sha256 /workspace/artifacts/'
    TASK_IMAGE="$("${dc[@]}" images -q sim | head -n 1)"
    [[ -n "$TASK_IMAGE" ]] || { printf 'Start sim once before exporting its image identity.\n' >&2; exit 1; }
    docker image inspect "$TASK_IMAGE" --format '{{json .}}' > artifacts/simulation-image.json
    printf 'Exported artifacts/. Share a registry digest or docker save image for exact replication.\n'
    ;;
  pull) "${dc[@]}" pull sim ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
