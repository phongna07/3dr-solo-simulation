# Use a clean deployment directory; do not copy development .env values here.
COMPOSE_PROJECT_NAME=solo-release
RELEASE_PLATFORM=linux/amd64
SIM_IMAGE=ghcr.io/OWNER/solo-simulation@sha256:REPLACE_WITH_TESTED_DIGEST
COMPANION_IMAGE=ghcr.io/OWNER/solo-companion@sha256:REPLACE_WITH_TESTED_DIGEST
CONFIG_DIR=./config
RUNS_DIR=./runs
ARTIFACTS_DIR=./artifacts
LOCAL_UID=1000
LOCAL_GID=1000
READINESS_TIMEOUT=600
# Explicit software fallback for machines without configured GPU access.
LIBGL_ALWAYS_SOFTWARE=1
